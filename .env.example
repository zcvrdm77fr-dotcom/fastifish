# FastFishing API:n asetukset. Paikallinen `npm start` toimii ilman pakollisia arvoja.
# Tuotannossa serveri validoi kriittiset asetukset käynnistyksessä ja kieltäytyy käynnistymästä
# viallisella CORS-konfiguraatiolla. Täydet käyttöönotto-ohjeet: DEPLOY.md

# Mihin SQLite-tietokanta ja saaliskuvat tallennetaan. Tuotannossa tämän pitää osoittaa
# pysyvälle levylle. Oletus paikallisesti: ./data
# DATA_DIR=/var/data

# Erillinen kuvahakemisto, jos kuvat halutaan DATA_DIR:n ulkopuolelle.
# UPLOADS_DIR=/var/data/uploads

# Sallitut selain-origin-osoitteet pilkulla erotettuna. Tuotannossa tämä on pakollinen.
# Arvojen pitää olla origin-muodossa ilman polkua.
# ALLOWED_ORIGINS=https://fastfishin.com,https://www.fastfishin.com

# 1 kun frontend ja API ovat eri siteissä ja SameSite=None-cookie tarvitaan. Tuotannossa
# cross-site-originien pitää käyttää HTTPS:ää.
# CROSS_SITE_COOKIES=1

# Tuotannon API-palvelin ei oletuksena tarjoa repositorion frontend-/lähdetiedostoja.
# Paikallisessa kehityksessä frontend tarjoillaan oletuksena. Aseta tarvittaessa eksplisiittisesti.
# SERVE_FRONTEND=0

# NODE_ENV=production
# PORT=3000

# Pilkulla erotetut ylläpitäjät, joilla on oikeus poistaa muiden julkaisuja ja kommentteja.
# Älä tallenna oikeaa tuotantoarvoa julkiseen repoon.
# ADMIN_USERNAMES=oma-kayttajanimi

# FastFishing ei käytä JWT-tokeneita eikä DATABASE_URL-muuttujaa: sessiot ovat satunnaisia
# bearer/cookie-tokeneita (vain SHA-256-digest tallennetaan tietokantaan) ja tietokanta on SQLite.
