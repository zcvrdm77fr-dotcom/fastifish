# FastFishing API:n asetukset. Paikallinen `npm start` toimii ilman pakollisia arvoja.
# Tuotannossa serveri validoi kriittiset asetukset käynnistyksessä ja kieltäytyy käynnistymästä
# viallisella CORS-konfiguraatiolla. Täydet käyttöönotto-ohjeet: DEPLOY.md

# Mihin SQLite-tietokanta, paikalliset backupit ja saaliskuvat tallennetaan. Tuotannossa tämän
# pitää osoittaa pysyvälle levylle. Oletus paikallisesti: ./data
# DATA_DIR=/var/data

# Erillinen kuvahakemisto, jos kuvat halutaan DATA_DIR:n ulkopuolelle.
# UPLOADS_DIR=/var/data/uploads

# Sallitut selain-origin-osoitteet pilkulla erotettuna. Tuotannossa tämä on pakollinen.
# Arvojen pitää olla origin-muodossa ilman polkua, ja tuotannossa HTTPS on pakollinen.
# ALLOWED_ORIGINS=https://fastfishin.com,https://www.fastfishin.com

# FastFishing käyttää api.fastfishin.com-hostin HttpOnly, Secure, SameSite=Lax -istuntoevästettä.
# Bearer-tokenia ei palauteta JavaScriptille eikä tallenneta localStorageen.

# Tuotannon API-palvelin ei oletuksena tarjoa repositorion frontend-/lähdetiedostoja.
# Paikallisessa kehityksessä frontend tarjoillaan oletuksena. Aseta tarvittaessa eksplisiittisesti.
# SERVE_FRONTEND=0

# NODE_ENV=production
# PORT=3000

# Pilkulla erotetut ylläpitäjät, joilla on oikeus poistaa muiden julkaisuja ja kommentteja.
# Älä tallenna oikeaa tuotantoarvoa julkiseen repoon.
# ADMIN_USERNAMES=oma-kayttajanimi

# Paikalliset SQLite-snapshotit. Oletus: kerran vuorokaudessa, 7 uusinta säilytetään.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_LOCAL_RETENTION=7

# Valinnainen offsite-varmistus S3-yhteensopivaan object storageen (esim. Cloudflare R2).
# Aseta nämä vain tuotannon secretteinä. Endpointin tulee tukea path-style S3 PUT -pyyntöjä.
# BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=fastfishing-backups
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY_ID=...
# BACKUP_S3_SECRET_ACCESS_KEY=...
# BACKUP_S3_PREFIX=fastfishing

# FastFishing ei käytä JWT-tokeneita eikä DATABASE_URL-muuttujaa: sessiot ovat satunnaisia
# HttpOnly-cookie-tokeneita (vain SHA-256-digest tallennetaan tietokantaan) ja tietokanta on SQLite.
